---
const tiles = [
  { src: "/images/hero/water-relief.jpg", alt: "Project ZAM ZAM — free water for slum communities", caption: "Project ZAM ZAM", subcaption: "5 fleets · 50 lakh L · 90 days" },
  { src: "/images/hero/football.jpg",     alt: "Youth Engagement — sports, camps, workshops", caption: "Youth Engagement", subcaption: "Karate · Football · Workshops" },
  { src: "/images/hero/voter-camp.jpg",   alt: "Voter enrollment camp in Bengaluru", caption: "Voter Enrollment", subcaption: "500+ camps · 30k applications" },
  { src: "/images/hero/summer-camp.jpg",  alt: "ABF Summer Camps for Kids", caption: "Summer Camps", subcaption: "Karate · Football · Fitness" },
];
---

<div class="relative">
  <div class="grid grid-cols-2 gap-3 sm:gap-4">
    {tiles.map((t, i) => (
      <figure class:list={[
        "relative aspect-[4/5] rounded-2xl overflow-hidden ring-1 ring-brand-ink/10 shadow-card-lg group",
        i === 0 && "rotate-[-1.5deg]",
        i === 1 && "rotate-[1.5deg] mt-6",
        i === 2 && "rotate-[1deg]",
        i === 3 && "rotate-[-1deg] mt-6",
      ]}>
        <img src={t.src} alt={t.alt} loading="eager" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/40 to-transparent p-3 text-white">
          <div class="font-display text-sm sm:text-base leading-tight">{t.caption}</div>
          <div class="text-[10px] sm:text-[11px] text-white/80 leading-tight mt-0.5">{t.subcaption}</div>
        </figcaption>
      </figure>
    ))}
  </div>

  <!-- Floating brand stamp -->
  <div class="absolute -bottom-4 -left-4 hidden sm:block bg-brand-yellow rounded-2xl shadow-card-lg ring-1 ring-brand-ink/15 px-4 py-3">
    <div class="text-[10px] uppercase tracking-[0.18em] text-brand-ink/65 font-semibold">Since</div>
    <div class="font-display text-2xl leading-none">2024</div>
  </div>
  <div class="absolute -top-4 -right-4 hidden sm:block bg-brand-red text-white rounded-2xl shadow-card-lg px-4 py-3">
    <div class="text-[10px] uppercase tracking-[0.18em] text-white/75 font-semibold">A people's</div>
    <div class="font-display text-xl leading-none mt-0.5">Movement</div>
  </div>
</div>
