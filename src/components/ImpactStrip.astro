---
import fallback from "../../public/data/impact.json";
const csvUrl = import.meta.env.PUBLIC_IMPACT_CSV_URL ?? "";
---

<section
  id="impactStrip"
  class="bg-brand-ink text-white"
  data-csv-url={csvUrl}
  data-fallback-cases={fallback.totalCases}
  data-fallback-saved={fallback.totalSavedINR}
>
  <div class="container-x py-4 flex flex-col md:flex-row items-center gap-4 md:gap-6 justify-between text-center md:text-left">
    <a href="/projects/active-health" class="flex items-center gap-2 group min-w-0">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-red text-white text-base shrink-0" aria-hidden="true">＋</span>
      <span class="text-[11px] sm:text-xs uppercase tracking-[0.18em] text-white/60 group-hover:text-brand-yellow transition-colors whitespace-nowrap">Active Health · Live Impact</span>
    </a>

    <div class="flex items-center gap-5 sm:gap-8 justify-center">
      <div>
        <div class="font-display text-xl sm:text-2xl md:text-3xl tabular-nums" data-counter="cases">1,625+</div>
        <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-white/55">Cases Assisted</div>
      </div>
      <div class="h-8 w-px bg-white/15" aria-hidden="true"></div>
      <div>
        <div class="font-display text-xl sm:text-2xl md:text-3xl tabular-nums" data-counter="saved">₹3.77 Cr+</div>
        <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-white/55">Saved for Community</div>
      </div>
    </div>

    <a href="tel:+919364024365" class="btn-call text-xs sm:text-sm shrink-0">
      <span aria-hidden="true">📞</span><span>+91&nbsp;93640&nbsp;24365</span>
    </a>
  </div>
</section>

<script>
  type ImpactValues = { cases: number; saved: number };

  function formatINRCompact(n: number): string {
    if (n >= 1_00_00_000) return `₹${(n / 1_00_00_000).toFixed(2).replace(/\.?0+$/, "")} Cr+`;
    if (n >= 1_00_000) return `₹${(n / 1_00_000).toFixed(2).replace(/\.?0+$/, "")} Lakh+`;
    return `₹${n.toLocaleString("en-IN")}`;
  }

  function formatCases(n: number): string {
    return `${n.toLocaleString("en-IN")}+`;
  }

  function animateTo(el: HTMLElement, target: number, format: (n: number) => string) {
    const duration = 1400;
    const start = performance.now();
    function tick(now: number) {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = format(Math.floor(target * eased));
      if (t < 1) requestAnimationFrame(tick);
      else el.textContent = format(target);
    }
    requestAnimationFrame(tick);
  }

  function parseCSV(text: string): ImpactValues | null {
    const cells = text.split(/[\r\n,;]+/).map((c) => c.trim()).filter(Boolean);
    const nums = cells
      .map((c) => Number(c.replace(/[^\d.-]/g, "")))
      .filter((n) => Number.isFinite(n) && n > 0);
    if (nums.length < 2) return null;
    return { cases: Math.round(nums[0]), saved: Math.round(nums[1]) };
  }

  async function init() {
    const strip = document.getElementById("impactStrip");
    if (!strip) return;
    const csvUrl = strip.getAttribute("data-csv-url") || "";
    const fallback: ImpactValues = {
      cases: Number(strip.getAttribute("data-fallback-cases")) || 1625,
      saved: Number(strip.getAttribute("data-fallback-saved")) || 37752575,
    };
    const casesEl = strip.querySelector<HTMLElement>('[data-counter="cases"]');
    const savedEl = strip.querySelector<HTMLElement>('[data-counter="saved"]');
    if (!casesEl || !savedEl) return;

    let values = fallback;
    if (csvUrl) {
      try {
        const res = await fetch(csvUrl, { cache: "no-store" });
        if (res.ok) {
          const parsed = parseCSV(await res.text());
          if (parsed) values = parsed;
        }
      } catch {
        // network/CORS error — keep fallback
      }
    }

    // Reset to 0 then animate up
    casesEl.textContent = "0";
    savedEl.textContent = "₹0";
    animateTo(casesEl, values.cases, formatCases);
    animateTo(savedEl, values.saved, formatINRCompact);
  }

  // Defer until idle so it doesn't block paint
  if ("requestIdleCallback" in window) {
    (window as any).requestIdleCallback(init);
  } else {
    setTimeout(init, 200);
  }
</script>
