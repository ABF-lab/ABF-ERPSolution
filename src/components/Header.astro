---
const nav = [
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/events", label: "Events" },
  { href: "/relief", label: "Relief" },
  { href: "/updates", label: "Updates" },
  { href: "/media", label: "Media" },
  { href: "/get-involved", label: "Get Involved" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-brand-yellow/95 backdrop-blur supports-[backdrop-filter]:bg-brand-yellow/80 ring-1 ring-brand-ink/5">
  <div class="container-x flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Active Bengaluru Foundation home">
      <img src="/images/logo.png" alt="Active Bengaluru" class="h-11 w-auto" width="160" height="44" />
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm font-semibold">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-2 rounded-full transition-colors",
            path.startsWith(item.href) ? "bg-brand-ink text-white" : "text-brand-ink hover:bg-brand-ink/10",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden sm:flex items-center gap-2">
      <a href="tel:+919364024365" class="btn-call text-sm">
        <span aria-hidden="true">📞</span>
        <span class="hidden lg:inline">24/7 Helpline</span>
      </a>
      <a href="/donate" class="btn-primary text-sm">Donate</a>
    </div>

    <button id="mobileMenuBtn" class="md:hidden rounded-full p-2 hover:bg-brand-ink/10" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <!-- Mobile drawer: full-screen yellow overlay with logo, close button, large nav rows, and pinned CTAs at bottom. -->
  <div
    id="mobileMenu"
    class="md:hidden hidden fixed inset-0 z-50 bg-brand-yellow flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
  >
    <div class="absolute inset-x-0 top-0 h-1 bg-brand-red pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-1 bg-brand-red pointer-events-none" aria-hidden="true"></div>

    <div class="container-x py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2" aria-label="Home">
        <img src="/images/logo.png" alt="Active Bengaluru" class="h-11 w-auto" />
      </a>
      <button
        id="mobileMenuClose"
        class="rounded-full p-2 hover:bg-brand-ink/10"
        aria-label="Close menu"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M6 6l12 12M6 18L18 6"/>
        </svg>
      </button>
    </div>

    <nav class="container-x mt-2 flex-1 overflow-y-auto pb-4">
      <ul class="flex flex-col gap-1.5 text-lg font-semibold">
        {nav.map((item) => {
          const active = path === item.href || path.startsWith(item.href + "/");
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "flex items-center justify-between rounded-2xl px-5 py-4 transition-colors",
                  active
                    ? "bg-brand-ink text-white"
                    : "bg-white/40 text-brand-ink hover:bg-white/70 ring-1 ring-brand-ink/10",
                ]}
              >
                <span>{item.label}</span>
                <span aria-hidden="true" class={active ? "text-brand-yellow" : "text-brand-ink/30"}>→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="container-x py-5 border-t border-brand-ink/10 grid gap-3">
      <a href="/donate" class="btn-primary text-base justify-center w-full">Donate →</a>
      <a href="tel:+919364024365" class="btn-call text-base justify-center w-full">📞 24/7 Helpline · +91 93640 24365</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobileMenuBtn");
  const closeBtn = document.getElementById("mobileMenuClose");
  const menu = document.getElementById("mobileMenu");
  const root = document.documentElement;

  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", String(open));
    root.classList.toggle("overflow-hidden", open);
  }

  btn?.addEventListener("click", () => setOpen(menu?.classList.contains("hidden") ?? true));
  closeBtn?.addEventListener("click", () => setOpen(false));
  // Close on any nav-link click so going to a route or anchor collapses the drawer
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  // Escape key closes
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
</script>
