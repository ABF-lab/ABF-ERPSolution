---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const upiId = "abf007.06@cmsidfc";
const upiLink = `upi://pay?pa=${encodeURIComponent(upiId)}&pn=${encodeURIComponent("Active Bengaluru Foundation")}&cu=INR`;
---

<section class="group relative rounded-3xl bg-white ring-1 ring-brand-ink/10 shadow-card overflow-hidden h-full flex flex-col">
  <div class="h-1.5 bg-brand-red shrink-0"></div>

  <div class="p-5 sm:p-8 flex flex-col gap-5 sm:gap-6 flex-1">
    <!-- Header: stack on mobile, side-by-side on sm+ -->
    <div class="flex flex-col-reverse sm:flex-row sm:items-start sm:justify-between gap-4 sm:gap-5">
      <div class="min-w-0 flex-1">
        <span class="chip-red">Donate</span>
        <h3 class="mt-3 font-display text-[1.5rem] sm:text-3xl leading-[1.1] [overflow-wrap:anywhere]">Stand with the movement.</h3>
        <p class="mt-3 text-sm text-brand-ink/70 leading-relaxed">
          Tax-deductible under 80G. Receipt emailed instantly. UPI, cards, net-banking accepted.
        </p>
        <a href="/donate" class="btn-primary mt-4 text-sm">Donate now (80G receipt) →</a>
      </div>
      <a href={upiLink} class="shrink-0 group/qr self-start">
        <img src="/images/donate-qr.png" alt="Scan to pay via UPI" class="w-28 h-28 sm:w-28 sm:h-28 rounded-xl ring-1 ring-brand-ink/10 p-1.5 bg-white transition-transform group-hover/qr:scale-105" />
        <div class="mt-1.5 text-center text-[10px] uppercase tracking-wider text-brand-ink/55 font-semibold">Scan · UPI</div>
      </a>
    </div>

    <!-- Bank details — clean grid -->
    <div class="rounded-2xl bg-brand-cream p-4 sm:p-5 mt-auto">
      <div class="text-[11px] uppercase tracking-[0.18em] text-brand-ink/60 font-semibold">Or, direct bank transfer</div>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 sm:gap-x-5 gap-y-2 text-sm">
        <dt class="text-brand-ink/55">Account</dt><dd class="font-semibold [overflow-wrap:anywhere]">Active Bengaluru Foundation</dd>
        <dt class="text-brand-ink/55">A/c No.</dt><dd class="font-mono">10176511090</dd>
        <dt class="text-brand-ink/55">IFSC</dt><dd class="font-mono">IDFB0080168</dd>
        <dt class="text-brand-ink/55">Bank</dt><dd class="[overflow-wrap:anywhere]">IDFC FIRST · Frazer Town</dd>
      </dl>
      <div class="mt-4 pt-4 border-t border-brand-ink/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-[0.18em] text-brand-ink/60 font-semibold">UPI ID</div>
          <div class="font-mono font-semibold text-sm sm:text-base mt-0.5 [overflow-wrap:anywhere]">{upiId}</div>
        </div>
        <a href={upiLink} class="btn-primary text-sm w-full sm:w-auto justify-center">Pay via UPI →</a>
      </div>
    </div>
  </div>
</section>
