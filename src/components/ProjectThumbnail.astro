---
interface Props {
  title: string;
  category: "Project" | "Relief" | "Event";
  icon?: string;
  accent?: "yellow" | "red" | "ink" | "cream";
  badge?: string;
  flagship?: boolean;
}
const {
  title,
  category,
  icon = "sparkle",
  accent = "yellow",
  badge,
  flagship = false,
} = Astro.props;

const themes = {
  yellow: { bg: "bg-brand-yellow",      text: "text-brand-ink",   sub: "text-brand-ink/70",  iconStroke: "#1A1A1A", chip: "bg-brand-ink/10 text-brand-ink", line: "bg-brand-red/70" },
  red:    { bg: "bg-brand-red",         text: "text-white",       sub: "text-white/85",      iconStroke: "#FFFFFF", chip: "bg-white/15 text-white",         line: "bg-brand-yellow" },
  ink:    { bg: "bg-brand-ink",         text: "text-white",       sub: "text-white/75",      iconStroke: "#FFD23F", chip: "bg-white/10 text-white",         line: "bg-brand-yellow" },
  cream:  { bg: "bg-brand-cream",       text: "text-brand-ink",   sub: "text-brand-ink/65",  iconStroke: "#1A1A1A", chip: "bg-brand-ink/10 text-brand-ink", line: "bg-brand-red/70" },
} as const;

const t = themes[accent];
---

<div class:list={[
  "relative aspect-[16/10] w-full overflow-hidden rounded-t-3xl flex flex-col justify-between p-4 sm:p-6",
  t.bg, t.text,
]}>
  <!-- top row: category chip + badge -->
  <div class="flex items-start justify-between gap-2">
    <span class:list={["inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] uppercase tracking-[0.18em] font-semibold", t.chip]}>
      {category}
    </span>
    {flagship && (
      <span class="inline-flex items-center gap-1 rounded-full bg-brand-yellow text-brand-ink px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] font-bold ring-1 ring-brand-ink/20">★ Flagship</span>
    )}
    {badge && !flagship && (
      <span class:list={["inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] font-semibold", t.chip]}>{badge}</span>
    )}
  </div>

  <!-- main title row -->
  <div class="flex items-end justify-between gap-3">
    <div class="min-w-0 flex-1">
      <div class:list={["w-10 h-1 rounded-full mb-3", t.line]}></div>
      <h3 class="font-display leading-[0.95] tracking-tight text-[clamp(1.25rem,3.6vw,2rem)] [overflow-wrap:anywhere]">{title}</h3>
    </div>
    <div class="shrink-0 opacity-90" aria-hidden="true">
      <svg class="w-10 h-10 sm:w-14 sm:h-14" viewBox="0 0 48 48" fill="none" stroke={t.iconStroke} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        {icon === "heart" && (<path d="M24 41s-13-7.5-13-19a8 8 0 0 1 13-6 8 8 0 0 1 13 6c0 11.5-13 19-13 19Z"/>)}
        {icon === "first-aid" && (<><rect x="6" y="12" width="36" height="28" rx="4"/><path d="M24 20v12M18 26h12"/><path d="M18 12V8h12v4"/></>)}
        {icon === "drop" && (<path d="M24 6c6 9 12 14 12 21a12 12 0 1 1-24 0c0-7 6-12 12-21Z"/>)}
        {icon === "book" && (<path d="M8 8h12a6 6 0 0 1 4 1.5A6 6 0 0 1 28 8h12v30H28a4 4 0 0 0-4 4 4 4 0 0 0-4-4H8Z"/><path d="M24 9.5V42"/>)}
        {icon === "sprout" && (<><path d="M24 42v-14"/><path d="M24 28c0-6 6-10 12-10-1 7-6 11-12 11Z"/><path d="M24 28c0-6-6-10-12-10 1 7 6 11 12 11Z"/></>)}
        {icon === "shield" && (<><path d="M24 6 8 12v10c0 9 7 16 16 20 9-4 16-11 16-20V12Z"/><path d="m17 23 5 5 9-10"/></>)}
        {icon === "megaphone" && (<><path d="M6 20v8l24 8V12Z"/><path d="M30 14a10 10 0 0 1 0 20"/></>)}
        {icon === "vote" && (<><rect x="8" y="20" width="32" height="20" rx="2"/><path d="m17 16 7 7 14-14"/><path d="M16 30h16"/></>)}
        {icon === "shoes" && (<><path d="M6 30c0-2 2-3 4-3l8-1 4-6h6c2 0 3 1 4 3l8 4c2 1 4 3 4 6v3H6Z"/><path d="M14 27v3M22 26v4M30 25v5"/></>)}
        {icon === "ball" && (<><circle cx="24" cy="24" r="16"/><path d="M24 8v32M8 24h32M14 14l20 20M34 14 14 34"/></>)}
        {icon === "mosque" && (<><path d="M24 4c4 6 10 8 10 14v6H14v-6c0-6 6-8 10-14Z"/><rect x="6" y="24" width="36" height="18"/><path d="M20 42v-8a4 4 0 0 1 8 0v8"/></>)}
        {icon === "chart" && (<><path d="M8 40V8M8 40h32"/><rect x="14" y="26" width="6" height="14"/><rect x="24" y="18" width="6" height="22"/><rect x="34" y="10" width="6" height="30"/></>)}
        {icon === "sparkle" && (<><path d="M24 6v36M6 24h36"/><path d="m12 12 24 24M36 12 12 36"/></>)}
        {icon === "compass" && (<><circle cx="24" cy="24" r="16"/><path d="m17 31 5-14 14-5-5 14Z"/><circle cx="24" cy="24" r="2.5" fill={t.iconStroke}/></>)}
        {icon === "people" && (<><circle cx="16" cy="16" r="5"/><circle cx="32" cy="16" r="5"/><path d="M6 38c0-6 5-10 10-10s10 4 10 10"/><path d="M22 38c0-6 5-10 10-10s10 4 10 10"/></>)}
        {icon === "handshake" && (<><path d="M6 26 14 18l6 4 8-2 6 4 8-4"/><path d="m20 22 6 6"/><path d="m26 28 4 4 6-2"/></>)}
      </svg>
    </div>
  </div>
</div>
