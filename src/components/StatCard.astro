---
interface Props {
  value: string;
  label: string;
  accent?: "yellow" | "red" | "ink";
}
const { value, label, accent = "ink" } = Astro.props;

const accentClasses = {
  yellow: "bg-brand-yellow text-brand-ink",
  red: "bg-brand-red text-white",
  ink: "bg-brand-ink text-white",
};
---

<div class={`rounded-2xl p-5 ${accentClasses[accent]}`}>
  <div class="font-display text-3xl sm:text-4xl tabular-nums leading-none">{value}</div>
  <div class="mt-2 text-xs uppercase tracking-wider opacity-75">{label}</div>
</div>
