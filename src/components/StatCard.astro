---
interface Props {
  value: string;
  label: string;
  accent?: "yellow" | "red" | "ink";
}
const { value, label, accent = "ink" } = Astro.props;

const accentClasses = {
  yellow: "bg-brand-yellow text-brand-ink",
  red: "bg-brand-red text-white",
  ink: "bg-brand-ink text-white",
};

// Scale font size based on value length so long phrases like "Community-led"
// or "Multi-stakeholder" don't overflow the card on mobile.
const len = value.length;
const valueSize =
  len <= 8  ? "text-[clamp(1.5rem,5vw,2.25rem)]"
: len <= 14 ? "text-[clamp(1.15rem,3.6vw,1.5rem)]"
:             "text-[clamp(1rem,3vw,1.25rem)]";
---

<div class={`rounded-2xl p-4 sm:p-5 flex flex-col h-full ${accentClasses[accent]}`}>
  <div class={`font-display ${valueSize} tabular-nums leading-tight [overflow-wrap:anywhere] hyphens-auto`}>{value}</div>
  <div class="mt-auto pt-2 text-[10px] sm:text-xs uppercase tracking-wider opacity-75 leading-snug">{label}</div>
</div>
