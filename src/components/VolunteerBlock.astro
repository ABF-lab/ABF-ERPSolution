---
const phoneDisplay = "+91 93640 24365";
const phoneTel = "+919364024365";
const whatsappLink = "https://wa.me/919364024365";
const email = "activebengaluru@gmail.com";
---

<section class="group relative rounded-3xl bg-white ring-1 ring-brand-ink/10 shadow-card overflow-hidden h-full flex flex-col">
  <div class="h-1.5 bg-brand-yellow-deep shrink-0"></div>

  <div class="p-5 sm:p-8 flex flex-col gap-5 sm:gap-6 flex-1">
    <!-- Header: stack on mobile, side-by-side on sm+ -->
    <div class="flex flex-col-reverse sm:flex-row sm:items-start sm:justify-between gap-4 sm:gap-5">
      <div class="min-w-0 flex-1">
        <span class="chip">Volunteer</span>
        <h3 class="mt-3 font-display text-[1.5rem] sm:text-3xl leading-[1.1] [overflow-wrap:anywhere]">Be part of <span class="accent-red">the movement.</span></h3>
        <p class="mt-3 text-sm text-brand-ink/70 leading-relaxed">
          If you have the passion to work for civic society and the upliftment of the underprivileged — we want you on the team. Active Volunteer or Active Giver, every hour counts.
        </p>
      </div>
      <a href={whatsappLink} target="_blank" rel="noopener" class="shrink-0 group/qr self-start">
        <img src="/images/volunteer-qr.png" alt="Scan to join as volunteer or giver" class="w-28 h-28 sm:w-28 sm:h-28 rounded-xl ring-1 ring-brand-ink/10 p-1.5 bg-white transition-transform group-hover/qr:scale-105" />
        <div class="mt-1.5 text-center text-[10px] uppercase tracking-wider text-brand-ink/55 font-semibold">Scan · Join</div>
      </a>
    </div>

    <!-- Three ways to reach us — match height of donate card's bank section -->
    <div class="rounded-2xl bg-brand-cream p-4 sm:p-5 mt-auto">
      <div class="text-[11px] uppercase tracking-[0.18em] text-brand-ink/60 font-semibold">Three ways to reach us</div>
      <ul class="mt-3 grid gap-2.5 text-sm">
        <li>
          <a href={whatsappLink} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl bg-white ring-1 ring-brand-ink/8 hover:ring-brand-red transition-all p-3 group/row">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#25D366]/15 text-[#128C7E]" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11 11 0 0 0 3.6 17.3L2.5 21.5l4.3-1.1A11 11 0 1 0 20.5 3.5Zm-8.5 17a9 9 0 0 1-4.6-1.3l-.3-.2-2.6.7.7-2.5-.2-.3a9 9 0 1 1 7 3.6Zm5-6.7c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2s-.8 1-1 1.2-.4.2-.7 0a7.4 7.4 0 0 1-2.2-1.4 8 8 0 0 1-1.5-1.9c-.2-.3 0-.5.1-.6l.5-.6.3-.5v-.5c0-.1-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4a3 3 0 0 0-1 2.3 5.4 5.4 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4 5 5 0 0 0 3 .6 2.8 2.8 0 0 0 1.8-1.3c.2-.5.2-.9.1-1l-.7-.4Z"/></svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[10px] uppercase tracking-wider text-brand-ink/55 font-semibold">WhatsApp · Helpline</div>
              <div class="font-display text-base mt-0.5">{phoneDisplay}</div>
            </div>
            <span class="text-brand-ink/40 group-hover/row:text-brand-red transition-colors" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={`tel:${phoneTel}`} class="flex items-center gap-3 rounded-xl bg-white ring-1 ring-brand-ink/8 hover:ring-brand-red transition-all p-3 group/row">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-red/10 text-brand-red" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[10px] uppercase tracking-wider text-brand-ink/55 font-semibold">Call · 24/7</div>
              <div class="font-display text-base mt-0.5">{phoneDisplay}</div>
            </div>
            <span class="text-brand-ink/40 group-hover/row:text-brand-red transition-colors" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${email}`} class="flex items-center gap-3 rounded-xl bg-white ring-1 ring-brand-ink/8 hover:ring-brand-red transition-all p-3 group/row">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-ink/10 text-brand-ink" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[10px] uppercase tracking-wider text-brand-ink/55 font-semibold">Email</div>
              <div class="font-mono text-[11px] sm:text-sm mt-0.5 truncate">{email}</div>
            </div>
            <span class="text-brand-ink/40 group-hover/row:text-brand-red transition-colors" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
