---
import { initials, type TeamGroup } from "../data/team";

interface Props {
  group: TeamGroup;
}
const { group } = Astro.props;
---

<div class="mt-12 first:mt-8">
  <div class="max-w-2xl">
    <h3 class="font-display text-xl sm:text-2xl text-brand-ink leading-tight">{group.title}</h3>
    <p class="mt-2 text-sm sm:text-base text-brand-ink/70 leading-relaxed">{group.blurb}</p>
  </div>

  <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    {group.members.map((m) => (
      <li class="relative h-full rounded-2xl bg-white ring-1 ring-brand-ink/10 shadow-card p-4 sm:p-5 flex flex-col items-center text-center hover:shadow-card-lg transition-shadow">
        <div class="relative">
          {m.photo ? (
            <img
              src={m.photo}
              alt={m.name}
              class="w-16 h-16 sm:w-24 sm:h-24 rounded-full object-cover ring-2 ring-brand-yellow"
              loading="lazy"
            />
          ) : (
            <div
              aria-hidden="true"
              class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-brand-yellow ring-2 ring-brand-yellow-deep flex items-center justify-center font-display text-xl sm:text-3xl text-brand-ink leading-none select-none"
            >
              {initials(m.name)}
            </div>
          )}
        </div>

        <div class="mt-3 min-w-0 w-full">
          <div class="font-semibold text-[13px] sm:text-base text-brand-ink leading-snug break-words">{m.name}</div>
          <div class="mt-1 text-[10px] sm:text-[11px] uppercase tracking-wider text-brand-ink/55 font-semibold">
            {m.role}
          </div>
        </div>

        <!-- LinkedIn icon: enabled when URL present, dimmed/disabled otherwise -->
        {m.linkedin ? (
          <a
            href={m.linkedin}
            target="_blank"
            rel="noopener"
            aria-label={`${m.name} on LinkedIn`}
            class="absolute top-2.5 right-2.5 inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-ink/5 hover:bg-[#0A66C2] hover:text-white transition-colors text-brand-ink/70"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14ZM8.34 18V10.5H6V18h2.34ZM7.17 9.43a1.36 1.36 0 1 0 0-2.72 1.36 1.36 0 0 0 0 2.72ZM18 18v-4.13c0-2.06-1.1-3.02-2.57-3.02-1.18 0-1.71.65-2.01 1.1V10.5H11.1c.03.66 0 7.5 0 7.5h2.32v-4.19c0-.21.02-.42.08-.57.16-.42.55-.85 1.18-.85.84 0 1.17.64 1.17 1.57V18H18Z"/>
            </svg>
          </a>
        ) : (
          <span
            aria-hidden="true"
            title="LinkedIn — coming soon"
            class="absolute top-2.5 right-2.5 inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-ink/5 text-brand-ink/25"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14ZM8.34 18V10.5H6V18h2.34ZM7.17 9.43a1.36 1.36 0 1 0 0-2.72 1.36 1.36 0 0 0 0 2.72ZM18 18v-4.13c0-2.06-1.1-3.02-2.57-3.02-1.18 0-1.71.65-2.01 1.1V10.5H11.1c.03.66 0 7.5 0 7.5h2.32v-4.19c0-.21.02-.42.08-.57.16-.42.55-.85 1.18-.85.84 0 1.17.64 1.17 1.57V18H18Z"/>
            </svg>
          </span>
        )}
      </li>
    ))}
  </ul>
</div>
