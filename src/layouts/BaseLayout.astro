---
import "../styles/globals.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImpactStrip from "../components/ImpactStrip.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideImpactStrip?: boolean;
}

const {
  title = "Active Bengaluru Foundation — A People's Movement",
  description = "ABF bridges NGOs, government, and civil society to uplift the underprivileged in Bengaluru and Karnataka. Active Health helpline, drug de-addiction, education, water relief, and more.",
  image = "/images/logo.png",
  hideImpactStrip = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://www.activebengaluru.org");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFD23F" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site ?? "https://www.activebengaluru.org").toString()} />
    <meta property="og:url" content={canonical.toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? "https://www.activebengaluru.org").toString()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Analytics: drop a Plausible/GA snippet here when ready -->
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {!hideImpactStrip && <ImpactStrip />}
    <Footer />
  </body>
</html>
