---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const updates = (await getCollection("updates")).sort(
  (a, b) => b.data.publishedOn.getTime() - a.data.publishedOn.getTime()
);

function fmtDate(d: Date): string {
  return d.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout title="Updates — Active Bengaluru Foundation" description="Latest issues of Active Updates — our regular newsletter on the projects, campaigns, and impact of ABF.">
  <section class="bg-brand-yellow">
    <div class="container-x py-14 sm:py-20">
      <span class="chip">Updates</span>
      <h1 class="mt-4 heading-display"><span class="accent-red">Active</span> Updates.</h1>
      <p class="mt-5 max-w-2xl text-lg text-brand-ink/80 leading-relaxed">
        Latest projects, programmes, and impact — straight from the ground.
      </p>
    </div>
  </section>

  <section class="container-x py-12 sm:py-16">
    <div class="grid gap-6 lg:grid-cols-2">
      {updates.map((u) => (
        <a href={`/updates/${u.slug}`} class="group card hover:shadow-card-lg transition-all">
          {u.data.coverImage && (
            <div class="aspect-[16/9] overflow-hidden bg-brand-yellow-soft">
              <img src={u.data.coverImage} alt={u.data.title} class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
            </div>
          )}
          <div class="p-6">
            <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-brand-ink/55 font-semibold">
              {u.data.issue && <span>{u.data.issue}</span>}
              <span>·</span>
              <time>{fmtDate(u.data.publishedOn)}</time>
            </div>
            <h3 class="font-display text-2xl mt-2">{u.data.title}</h3>
            <p class="mt-3 text-brand-ink/75 leading-relaxed line-clamp-3">{u.data.summary}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold group-hover:text-brand-red">Read issue <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
