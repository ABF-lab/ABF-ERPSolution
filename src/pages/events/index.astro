---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const events = (await getCollection("events")).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection("projects");
const projectTitles = new Map(projects.map((p) => [p.slug, p.data.title]));
---

<BaseLayout title="Events — Active Bengaluru Foundation" description="Programmatic gatherings, training sessions, awards, advocacy meetings, and community workshops organised by ABF across Karnataka.">
  <section class="bg-brand-yellow">
    <div class="container-x py-14 sm:py-20">
      <span class="chip-red">Events</span>
      <h1 class="mt-4 heading-display">Where the work <span class="accent-red">comes alive</span>.</h1>
      <p class="mt-5 max-w-2xl text-lg text-brand-ink/80 leading-relaxed">
        Awards, training sessions, advocacy meetings, summer camps, tournaments, and the gatherings that turn long-term programmes into lived community moments.
      </p>
    </div>
  </section>

  <section class="container-x py-12 sm:py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {events.map((e) => {
        const parentTitle = e.data.relatedProject ? projectTitles.get(e.data.relatedProject) : undefined;
        return (
          <div class="flex flex-col">
            <ProjectCard
              href={`/events/${e.slug}`}
              title={e.data.title}
              tagline={e.data.tagline}
              summary={e.data.summary}
              category="Event"
              icon={e.data.thumbnailIcon}
              accent={e.data.thumbnailAccent}
              badge={e.data.occurredOn}
            />
            {parentTitle && (
              <a href={`/projects/${e.data.relatedProject}`} class="mt-2 self-start inline-flex items-center gap-1 text-xs font-semibold text-brand-ink/65 hover:text-brand-red px-2 py-1 rounded-full bg-brand-cream">
                Part of <span class="font-bold ml-1">{parentTitle}</span>
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
