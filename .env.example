# =============================================================================
# Active Bengaluru Foundation — environment variables
# =============================================================================
# Copy this file to `.env` for local dev, OR add these as Environment Variables
# in Vercel → Project Settings → Environment Variables for production.
# See SETUP.md for step-by-step instructions on getting each value.
# =============================================================================

# --- Active Health live counter (optional) ---
# Published Google Sheet CSV URL — leave blank to use fallback in public/data/impact.json
PUBLIC_IMPACT_CSV_URL=

# --- Razorpay (REQUIRED for /donate to work) ---
# Get these from https://dashboard.razorpay.com → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret — set this in Razorpay → Webhooks panel
# AND copy the same value here
RAZORPAY_WEBHOOK_SECRET=

# --- Email (REQUIRED for receipt sending) ---
# Resend API key from https://resend.com → API Keys
RESEND_API_KEY=

# The "From" address. While testing use the Resend default; once you verify
# your domain in Resend, switch to e.g. "Active Bengaluru <donations@activebengaluru.org>"
FROM_EMAIL=Active Bengaluru <onboarding@resend.dev>

# Where the internal copy of each receipt is sent (comma-separated for multiple)
FINANCE_EMAIL=activebengaluru@gmail.com

# Reply-to address shown to donors (where they reply if they have questions)
REPLY_TO_EMAIL=activebengaluru@gmail.com

# --- Google Sheet append (REQUIRED for /donate to log + assign receipt #s) ---
# Apps Script web-app URL — see SETUP.md for the script template
GOOGLE_SHEET_WEBHOOK_URL=
# Shared secret token to prevent random callers from writing to your sheet
GOOGLE_SHEET_WEBHOOK_TOKEN=

# --- /admin login (REQUIRED for the donations admin page) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Organisation legal info (used in 80G receipt PDF) ---
ORG_LEGAL_NAME=Active Bengaluru Foundation
ORG_ADDRESS=No 12, 1st Floor, Lazar Road, Fraser Town, Bangalore 560005, Karnataka, India
ORG_PAN=
ORG_CIN=U85500KA2024NPL184982
ORG_12A_NUMBER=
ORG_80G_NUMBER=
ORG_SIGNATORY_NAME=
ORG_SIGNATORY_TITLE=Director, Active Bengaluru Foundation
